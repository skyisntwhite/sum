//@version=6
indicator("Combined Daily HL & Swing Detector", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// === Common Variables ===
var transpColor = color.new(color.white, 100)

// === Previous Day High/Low Settings ===
utcOffset = input.int(0, title="UTC Offset (in hours)", minval=-12, maxval=12)
utcOffsetInMs = utcOffset * 60 * 60 * 1000

// Daily separator inputs
var dailyGroup = "Daily Separator"
dailySeparatorColor = input.color(color.orange, title="Color", group=dailyGroup)
dailySeparatorStyleInput = input.string("Solid", title="Style", options=["Solid", "Dotted"], group=dailyGroup)
dailySeparatorWidthInput = input.int(1, title="Width", minval=1, group=dailyGroup)
dailySeparatorLabelTextColor = input.color(color.white, title="Label Text Color", group=dailyGroup)
dailySeparatorStyle = dailySeparatorStyleInput == "Solid" ? line.style_solid : line.style_dotted

// Weekly separator inputs
var weeklyGroup = "Weekly Separator"
weeklySeparatorColorInput = input.color(color.gray, title="Color", group=weeklyGroup)
weeklySeparatorStyleInput = input.string("Solid", title="Style", options=["Solid", "Dotted"], group=weeklyGroup)
weeklySeparatorWidthInput = input.int(3, title="Width", minval=1, group=weeklyGroup)
weeklySeparatorStyle = weeklySeparatorStyleInput == "Solid" ? line.style_solid : line.style_dotted

// Previous Day H&L inputs
var prevDayHLGroup = "Previous Day H&L"
prevDayHLColorInput = input.color(color.gray, title="Color", group=prevDayHLGroup)
prevDayHLTextColorInput = input.color(color.orange, title="Text Color", group=prevDayHLGroup)
prevDayHLStyleInput = input.string("Dotted", title="Style", options=["Solid", "Dotted"], group=prevDayHLGroup)
prevDayHLWidthInput = input.int(3, title="Width", minval=1, group=prevDayHLGroup)
prevDayHLStyle = prevDayHLStyleInput == "Solid" ? line.style_solid : line.style_dotted

// === Swing High/Low Detector Settings ===
internalShiftMode = input.string("High/Low", title="Internal Shift Mode", options=["Open", "High/Low"], group="Swing Detection")

// Customizable Label Colors
colorHH = input.color(color.rgb(76, 175, 79, 75), title="Background Color: HH", group="Swing Labels")
colorLH = input.color(color.rgb(255, 0, 0, 75), title="Background Color: LH", group="Swing Labels")
colorLL = input.color(color.rgb(255, 0, 0, 75), title="Background Color: LL", group="Swing Labels")
colorHL = input.color(color.rgb(76, 175, 79, 75), title="Background Color: HL", group="Swing Labels")

textHH = input.color(color.green, title="Text Color: HH", group="Swing Labels")
textLH = input.color(color.red, title="Text Color: LH", group="Swing Labels")
textLL = input.color(color.red, title="Text Color: LL", group="Swing Labels")
textHL = input.color(color.green, title="Text Color: HL", group="Swing Labels")

// Fibonacci Settings
showBullishFibs = input.bool(true, title="Show Bullish Fibonacci Lines", group="Fibonacci")
showBearishFibs = input.bool(true, title="Show Bearish Fibonacci Lines", group="Fibonacci")
deleteOldFibs = input.bool(true, title="Delete Old Fibonacci Lines", group="Fibonacci")
fibLength = input.int(25, title="Fibonacci Line Length (Bars)", minval=1, group="Fibonacci")

// Fibonacci Colors
fibColor_0   = input.color(color.new(color.white, 0), "Fibonacci 0.0 Color", group="Fibonacci Colors")
fibColor_236 = input.color(color.new(color.purple, 10), "Fibonacci 0.236 Color", group="Fibonacci Colors")
fibColor_382 = input.color(color.new(color.purple, 20), "Fibonacci 0.382 Color", group="Fibonacci Colors")
fibColor_500 = input.color(color.new(color.orange, 30), "Fibonacci 0.5 Color", group="Fibonacci Colors")
fibColor_618 = input.color(color.new(color.orange, 40), "Fibonacci 0.618 Color", group="Fibonacci Colors")
fibColor_786 = input.color(color.new(color.black, 50), "Fibonacci 0.786 Color", group="Fibonacci Colors")
fibColor_100 = input.color(color.new(color.white, 60), "Fibonacci 1.0 Color", group="Fibonacci Colors")

// === Helper Functions ===
_isNewDay(utcOffsetInMs) =>
    dow = dayofweek(time + utcOffsetInMs)
    dayChanged = dow != dow[1]
    dayChanged

_isNewWeek(utcOffsetInMs) =>
    woy = weekofyear(time + utcOffsetInMs)
    weekChanged = woy != woy[1]
    weekChanged

_bottomMarkText(barTime, utcOffsetInMs) =>
    var monthShortNames = array.from("", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
    var weekdayShortNames = array.from("", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")
    weekdayShort = array.get(weekdayShortNames, dayofweek(barTime + utcOffsetInMs))
    out = weekdayShort + 
         " " + str.tostring(dayofmonth(barTime + utcOffsetInMs)) +
         " " + array.get(monthShortNames, month(barTime + utcOffsetInMs)) +
         " '" + str.substring(str.tostring(year(barTime + utcOffsetInMs)), 2) +
         " " + str.format_time(barTime, "HH:mm")

_getPreviousDayHighLow(utcOffsetInMs) =>
    dow = dayofweek(time + utcOffsetInMs)
    var prevDayHigh = high
    var prevDayHighTime = time
    var prevDayLow = low
    var prevDayLowTime = time
    var dayHigh = high
    var dayHighTime = time
    var dayLow = low
    var dayLowTime = time

    if (dow != dow[1])
        dayHigh := high
        dayHighTime := time
        dayLow := low
        dayLowTime := time
        prevDayHigh := dayHigh[1]
        prevDayHighTime := dayHighTime[1]
        prevDayLow := dayLow[1]
        prevDayLowTime := dayLowTime[1]
    else
        if dayHigh < high
            dayHigh := high
            dayHighTime := time
        if dayLow > low
            dayLow := low
            dayLowTime := time

    [prevDayHigh, prevDayHighTime, prevDayLow, prevDayLowTime]

// === State Variables ===
var int lastInternalShift = 0
var int lastBullishShiftBar = na
var int lastBearishShiftBar = na
var float prevSwingHigh = na
var float prevSwingLow = na
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastHighIndex = na
var int lastLowIndex = na
var bool isHH = false
var bool isHL = false
var bool isLL = false
var bool isLH = false

// === Previous Day High/Low Logic ===
var box weekdayTopLabelBox = na
var box[] weekdayTopLabels = array.new_box()
var label[] weekdayBottomLabels = array.new_label()

var weekdayFullNames = array.from("", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday")

// Plot daily separator line
isNewDay = _isNewDay(utcOffsetInMs)
isNewWeek = _isNewWeek(utcOffsetInMs)

if isNewDay
    weekdayFull = array.get(weekdayFullNames, dayofweek(time + utcOffsetInMs))
    line.new(time, low, time, high, 
             xloc=xloc.bar_time,
             style=dailySeparatorStyle,
             width=dailySeparatorWidthInput,
             color=dailySeparatorColor,
             extend=extend.both)
             
    weekdayTopLabelBox := box.new(time, high, time, low,
                                 xloc=xloc.bar_time,
                                 bgcolor=transpColor,
                                 border_color=transpColor,
                                 text=weekdayFull,
                                 text_color=dailySeparatorColor,
                                 text_size=size.small,
                                 text_halign=text.align_center,
                                 text_valign=text.align_top)
    array.push(weekdayTopLabels, weekdayTopLabelBox)
    array.push(weekdayBottomLabels, label.new(time, low,
                                             xloc=xloc.bar_time,
                                             text=_bottomMarkText(time, utcOffsetInMs),
                                             color=dailySeparatorColor,
                                             textcolor=dailySeparatorLabelTextColor,
                                             style=label.style_label_up))
else
    box.set_right(weekdayTopLabelBox, time)

// Plot weekly separator line
if isNewWeek
    line.new(time, low, time, high,
             xloc=xloc.bar_time,
             color=weeklySeparatorColorInput,
             style=weeklySeparatorStyle,
             width=weeklySeparatorWidthInput,
             extend=extend.both)

// Plot previous day high/low lines with fixed positioning
[prevDayHigh, prevDayHighTime, prevDayLow, prevDayLowTime] = _getPreviousDayHighLow(utcOffsetInMs)
var line prevDayHighLine = line.new(time, prevDayHigh, time, prevDayHigh,
                                   xloc=xloc.bar_time,
                                   color=prevDayHLColorInput,
                                   width=1)
var label prevDayHighLabel = label.new(time, prevDayHigh,
                                      xloc=xloc.bar_time,
                                      text="HOD",
                                      color=transpColor,
                                      textcolor=prevDayHLTextColorInput,
                                      style=label.style_label_down)

var line prevDayLowLine = line.new(time, prevDayLow, time, prevDayLow,
                                  xloc=xloc.bar_time,
                                  color=prevDayHLColorInput,
                                  width=1)
var label prevDayLowLabel = label.new(time, prevDayLow,
                                     xloc=xloc.bar_time,
                                     text="LOD",
                                     color=transpColor,
                                     textcolor=prevDayHLTextColorInput,
                                     style=label.style_label_up)

if isNewDay
    line.set_xy1(prevDayHighLine, prevDayHighTime, prevDayHigh)
    line.set_xy2(prevDayHighLine, prevDayHighTime, prevDayHigh)
    label.set_xy(prevDayHighLabel, prevDayHighTime, prevDayHigh)

    line.set_xy1(prevDayLowLine, prevDayLowTime, prevDayLow)
    line.set_xy2(prevDayLowLine, prevDayLowTime, prevDayLow)
    label.set_xy(prevDayLowLabel, prevDayLowTime, prevDayLow)
else
    t = time
    line.set_x2(prevDayHighLine, t)
    label.set_x(prevDayHighLabel, t)
    line.set_x2(prevDayLowLine, t)
    label.set_x(prevDayLowLabel, t)

// === Swing High/Low Detection Logic ===
isBullish = close > open
isBearish = close < open
isNeutral = open == close

var int bullishCount = 0
var int bearishCount = 0
var float lowestBullishPrice = na
var float highestBearishPrice = na
var float firstBullishOpen = na
var float firstBearishOpen = na

if not isNeutral
    if isBullish
        bullishCount += 1
        bearishCount := 0
        if bullishCount == 1 or low < lowestBullishPrice
            lowestBullishPrice := low
        if bullishCount == 1
            firstBullishOpen := open
    else
        bearishCount += 1
        bullishCount := 0
        if bearishCount == 1 or high > highestBearishPrice
            highestBearishPrice := high
        if bearishCount == 1
            firstBearishOpen := open

internalShiftBullish = internalShiftMode == "Open" ? close > firstBearishOpen : close > highestBearishPrice
internalShiftBearish = internalShiftMode == "Open" ? close < firstBullishOpen : close < lowestBullishPrice

allowInternalShiftBullish = internalShiftBullish and lastInternalShift != 1
allowInternalShiftBearish = internalShiftBearish and lastInternalShift != -1

// === Line Storage Arrays ===
var line[] bullFibLines = array.new_line()
var line[] bearFibLines = array.new_line()

// === Helper Function to Clear Lines ===
f_clear_lines(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            ln = array.get(arr, i)
            line.delete(ln)
        array.clear(arr)

// === Swing Detection and Fibonacci Drawing Logic with Fixed Positioning ===
if allowInternalShiftBullish
    lastInternalShift := 1
    lastBullishShiftBar := bar_index
    t = time

    // Find lowest point between shifts
    shiftLength = bar_index - lastBearishShiftBar
    if shiftLength <= 1000 and not na(lastBearishShiftBar)
        lowest = low
        lowIndex = bar_index
        lowTime = time
        for i = 0 to shiftLength
            if low[i] < lowest
                lowest := low[i]
                lowIndex := bar_index - i
                lowTime := time[i]

        isLL := not na(prevSwingLow) and lowest < prevSwingLow
        isHL := not na(prevSwingLow) and lowest > prevSwingLow

        if isLL
            label.new(lowTime, lowest, "LL",
                     xloc=xloc.bar_time,
                     style=label.style_label_up,
                     color=colorLL,
                     textcolor=textLL)
        else if isHL
            label.new(lowTime, lowest, "HL",
                     xloc=xloc.bar_time,
                     style=label.style_label_up,
                     color=colorHL,
                     textcolor=textHL)

        prevSwingLow := lowest
        lastSwingLow := lowest
        lastLowIndex := lowIndex

if allowInternalShiftBearish
    lastInternalShift := -1
    lastBearishShiftBar := bar_index
    t = time

    // Find highest point between shifts
    shiftLength = bar_index - lastBullishShiftBar
    if shiftLength <= 1000 and not na(lastBullishShiftBar)
        highest = high
        highIndex = bar_index
        highTime = time
        for i = 0 to shiftLength
            if high[i] > highest
                highest := high[i]
                highIndex := bar_index - i
                highTime := time[i]

        isHH := not na(prevSwingHigh) and highest > prevSwingHigh
        isLH := not na(prevSwingHigh) and highest < prevSwingHigh

        if isHH
            label.new(highTime, highest, "HH",
                     xloc=xloc.bar_time,
                     style=label.style_label_down,
                     color=colorHH,
                     textcolor=textHH)
        else if isLH
            label.new(highTime, highest, "LH",
                     xloc=xloc.bar_time,
                     style=label.style_label_down,
                     color=colorLH,
                     textcolor=textLH)

        prevSwingHigh := highest
        lastSwingHigh := highest
        lastHighIndex := highIndex

// === Draw Bullish Fibonacci Lines with Fixed Positioning ===
if allowInternalShiftBullish and showBullishFibs and not na(lastHighIndex) and not na(lastLowIndex)
    if deleteOldFibs
        f_clear_lines(bullFibLines)
    t = time
    fib0 = lastSwingLow
    fib100 = lastSwingHigh
    array.push(bullFibLines, line.new(time, fib0, time + fibLength * timeframe.multiplier * 60000, fib0, xloc=xloc.bar_time, color=fibColor_0))
    array.push(bullFibLines, line.new(time, fib0 + (fib100 - fib0) * 0.236, time + fibLength * timeframe.multiplier * 60000, fib0 + (fib100 - fib0) * 0.236, xloc=xloc.bar_time, color=fibColor_236))
    array.push(bullFibLines, line.new(time, fib0 + (fib100 - fib0) * 0.382, time + fibLength * timeframe.multiplier * 60000, fib0 + (fib100 - fib0) * 0.382, xloc=xloc.bar_time, color=fibColor_382))
    array.push(bullFibLines, line.new(time, fib0 + (fib100 - fib0) * 0.5, time + fibLength * timeframe.multiplier * 60000, fib0 + (fib100 - fib0) * 0.5, xloc=xloc.bar_time, color=fibColor_500))
    array.push(bullFibLines, line.new(time, fib0 + (fib100 - fib0) * 0.618, time + fibLength * timeframe.multiplier * 60000, fib0 + (fib100 - fib0) * 0.618, xloc=xloc.bar_time, color=fibColor_618))
    array.push(bullFibLines, line.new(time, fib0 + (fib100 - fib0) * 0.786, time + fibLength * timeframe.multiplier * 60000, fib0 + (fib100 - fib0) * 0.786, xloc=xloc.bar_time, color=fibColor_786))
    array.push(bullFibLines, line.new(time, fib100, time + fibLength * timeframe.multiplier * 60000, fib100, xloc=xloc.bar_time, color=fibColor_100))

// === Draw Bearish Fibonacci Lines with Fixed Positioning ===
if allowInternalShiftBearish and showBearishFibs and not na(lastHighIndex) and not na(lastLowIndex)
    if deleteOldFibs
        f_clear_lines(bearFibLines)
    t = time
    fib0 = lastSwingHigh
    fib100 = lastSwingLow
    array.push(bearFibLines, line.new(time, fib0, time + fibLength * timeframe.multiplier * 60000, fib0, xloc=xloc.bar_time, color=fibColor_0))
    array.push(bearFibLines, line.new(time, fib0 - (fib0 - fib100) * 0.236, time + fibLength * timeframe.multiplier * 60000, fib0 - (fib0 - fib100) * 0.236, xloc=xloc.bar_time, color=fibColor_236))
    array.push(bearFibLines, line.new(time, fib0 - (fib0 - fib100) * 0.382, time + fibLength * timeframe.multiplier * 60000, fib0 - (fib0 - fib100) * 0.382, xloc=xloc.bar_time, color=fibColor_382))
    array.push(bearFibLines, line.new(time, fib0 - (fib0 - fib100) * 0.5, time + fibLength * timeframe.multiplier * 60000, fib0 - (fib0 - fib100) * 0.5, xloc=xloc.bar_time, color=fibColor_500))
    array.push(bearFibLines, line.new(time, fib0 - (fib0 - fib100) * 0.618, time + fibLength * timeframe.multiplier * 60000, fib0 - (fib0 - fib100) * 0.618, xloc=xloc.bar_time, color=fibColor_618))
    array.push(bearFibLines, line.new(time, fib0 - (fib0 - fib100) * 0.786, time + fibLength * timeframe.multiplier * 60000, fib0 - (fib0 - fib100) * 0.786, xloc=xloc.bar_time, color=fibColor_786))
    array.push(bearFibLines, line.new(time, fib100, time + fibLength * timeframe.multiplier * 60000, fib100, xloc=xloc.bar_time, color=fibColor_100))

// === Alert Conditions ===
alertcondition(isHH, title="Higher High Detected", message="Higher High (HH) detected!")
alertcondition(isLH, title="Lower High Detected", message="Lower High (LH) detected!")
alertcondition(isLL, title="Lower Low Detected", message="Lower Low (LL) detected!")
alertcondition(isHL, title="Higher Low Detected", message="Higher Low (HL) detected!")

// === Fibonacci Cross Alert Conditions ===
fibCrossedBull(fibLevel) =>
    showBullishFibs and not na(fibLevel) and close[1] < fibLevel and close > fibLevel

fibCrossedBear(fibLevel) =>
    showBearishFibs and not na(fibLevel) and close[1] > fibLevel and close < fibLevel

// Bullish Fibs Cross Conditions
fib0_bull = fibCrossedBull(lastSwingLow)
fib236_bull = fibCrossedBull(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.236)
fib382_bull = fibCrossedBull(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.382)
fib500_bull = fibCrossedBull(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.5)
fib618_bull = fibCrossedBull(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.618)
fib786_bull = fibCrossedBull(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.786)
fib100_bull = fibCrossedBull(lastSwingHigh)

// Bearish Fibs Cross Conditions
fib0_bear = fibCrossedBear(lastSwingHigh)
fib236_bear = fibCrossedBear(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.236)
fib382_bear = fibCrossedBear(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.382)
fib500_bear = fibCrossedBear(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.5)
fib618_bear = fibCrossedBear(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.618)
fib786_bear = fibCrossedBear(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.786)
fib100_bear = fibCrossedBear(lastSwingLow)

// Fibonacci Cross Alerts
alertcondition(fib0_bull, title="Bullish Fib 0.0 Break", message="Price crossed bullish Fibonacci 0.0 level")
alertcondition(fib236_bull, title="Bullish Fib 0.236 Break", message="Price crossed bullish Fibonacci 0.236 level")
alertcondition(fib382_bull, title="Bullish Fib 0.382 Break", message="Price crossed bullish Fibonacci 0.382 level")
alertcondition(fib500_bull, title="Bullish Fib 0.5 Break", message="Price crossed bullish Fibonacci 0.5 level")
alertcondition(fib618_bull, title="Bullish Fib 0.618 Break", message="Price crossed bullish Fibonacci 0.618 level")
alertcondition(fib786_bull, title="Bullish Fib 0.786 Break", message="Price crossed bullish Fibonacci 0.786 level")
alertcondition(fib100_bull, title="Bullish Fib 1.0 Break", message="Price crossed bullish Fibonacci 1.0 level")

alertcondition(fib0_bear, title="Bearish Fib 0.0 Break", message="Price crossed bearish Fibonacci 0.0 level")
alertcondition(fib236_bear, title="Bearish Fib 0.236 Break", message="Price crossed bearish Fibonacci 0.236 level")
alertcondition(fib382_bear, title="Bearish Fib 0.382 Break", message="Price crossed bearish Fibonacci 0.382 level")
alertcondition(fib500_bear, title="Bearish Fib 0.5 Break", message="Price crossed bearish Fibonacci 0.5 level")
alertcondition(fib618_bear, title="Bearish Fib 0.618 Break", message="Price crossed bearish Fibonacci 0.618 level")
alertcondition(fib786_bear, title="Bearish Fib 0.786 Break", message="Price crossed bearish Fibonacci 0.786 level")
alertcondition(fib100_bear, title="Bearish Fib 1.0 Break", message="Price crossed bearish Fibonacci 1.0 level")
